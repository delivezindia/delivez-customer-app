# Copy to .env (repo root). Built into the app — after changing, run ./deploy/customer/update.sh
# The backend's public address. Empty only for local dev (then the dev proxy → http://localhost:4000 is used).
VITE_API_URL=https://partners.api.delivez.com
# Google Maps browser key — restrict it in Google Cloud to the customer app's domain
VITE_GOOGLE_MAPS_API_KEY=
